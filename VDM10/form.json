{
    "elements": [
        {
            "type": "Label",
            "caption": "Metzler VDM10 door station via ISAPI (local, no cloud). Enter the IP address and the admin password of the door station."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Host",
                    "caption": "IP address / host name",
                    "validate": "^[A-Za-z0-9.\\-_:]+$"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Port",
                    "caption": "HTTP port",
                    "minimum": 1,
                    "maximum": 65535
                },
                {
                    "type": "CheckBox",
                    "name": "UseHttps",
                    "caption": "HTTPS"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Username",
                    "caption": "User name"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "Password",
                    "caption": "Password"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Events",
            "expanded": false,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "StreamEnabled",
                    "caption": "Receive events via ISAPI alert stream (client socket)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "PollInterval",
                    "caption": "Poll call status every (s, 0 = off)",
                    "minimum": 0,
                    "maximum": 3600,
                    "suffix": "s"
                },
                {
                    "type": "NumberSpinner",
                    "name": "RingTimeout",
                    "caption": "Reset doorbell after",
                    "minimum": 5,
                    "maximum": 600,
                    "suffix": "s"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MotionReset",
                    "caption": "Reset motion after",
                    "minimum": 1,
                    "maximum": 3600,
                    "suffix": "s"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Doors, snapshots and live view",
            "expanded": false,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "DoorCount",
                    "caption": "Door openers",
                    "minimum": 1,
                    "maximum": 2
                },
                {
                    "type": "CheckBox",
                    "name": "SecurityModule",
                    "caption": "Metzler security module (Metzler-SM) installed"
                },
                {
                    "type": "CheckBox",
                    "name": "DoorContact",
                    "caption": "Door contact connected (at the security module or an input set to “Door contact”)"
                },
                {
                    "type": "Label",
                    "caption": "Note: Reducing the door openers or switching off the security module or door contact deletes the related variables including their archive data. Links, events and visualisation entries pointing to them stop working."
                },
                {
                    "type": "CheckBox",
                    "name": "SnapshotOnRing",
                    "caption": "Take a snapshot when the doorbell rings"
                },
                {
                    "type": "NumberSpinner",
                    "name": "SnapshotArchive",
                    "caption": "Keep previous snapshots",
                    "minimum": 0,
                    "maximum": 10
                },
                {
                    "type": "Select",
                    "name": "SnapshotChannel",
                    "caption": "Snapshot source",
                    "options": [
                        {
                            "caption": "Main stream (1280x720)",
                            "value": 101
                        },
                        {
                            "caption": "Sub stream",
                            "value": 102
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "StreamMedia",
                    "caption": "Create RTSP live view media object"
                },
                {
                    "type": "Select",
                    "name": "StreamChannel",
                    "caption": "Live view source",
                    "options": [
                        {
                            "caption": "Main stream",
                            "value": 101
                        },
                        {
                            "caption": "Sub stream",
                            "value": 102
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "A smaller snapshot archive or switching off the live view deletes the media objects that are no longer needed."
                },
                {
                    "type": "Label",
                    "caption": "Two-way audio: register the door station (SIP) with Symcon's door intercom module (DoorIP) or a FRITZ!Box. This module covers events, door openers, snapshots and the video stream."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Extension modules",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "SubModuleVariables",
                    "caption": "Variables for extension modules (status, display brightness, last bell button)"
                },
                {
                    "type": "Label",
                    "caption": "Note: Switching this off deletes these variables including their archived data."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Test connection",
            "onClick": "echo VDM10_TestConnection($id);"
        },
        {
            "type": "ExpansionPanel",
            "name": "PersonsPanel",
            "caption": "Persons, fingerprints and cards",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "Persons",
                    "caption": "Persons on the door station",
                    "rowCount": 6,
                    "add": true,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "No.",
                            "name": "employeeNo",
                            "width": "70px",
                            "add": ""
                        },
                        {
                            "caption": "Name",
                            "name": "name",
                            "width": "auto",
                            "add": ""
                        },
                        {
                            "caption": "Fingerprints",
                            "name": "fingerprints",
                            "width": "110px",
                            "add": 0
                        },
                        {
                            "caption": "Cards",
                            "name": "cards",
                            "width": "80px",
                            "add": 0
                        },
                        {
                            "caption": "Valid",
                            "name": "valid",
                            "width": "200px",
                            "add": ""
                        },
                        {
                            "caption": "Access schedule",
                            "name": "schedule",
                            "width": "180px",
                            "add": ""
                        },
                        {
                            "caption": "Photo",
                            "name": "photo",
                            "width": "150px",
                            "add": "–"
                        },
                        {
                            "name": "PersonNo",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "PersonName",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "PersonPin",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "PersonLimited",
                            "visible": false,
                            "add": false
                        },
                        {
                            "name": "PersonBegin",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "PersonEnd",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "PersonSchedule",
                            "visible": false,
                            "add": 0
                        },
                        {
                            "name": "PersonPhoto",
                            "visible": false,
                            "add": 0
                        }
                    ],
                    "values": [],
                    "form": "return json_decode(VDM10_UIPersonForm($id, $Persons['PersonNo'] ?? '', (bool) ($Persons['PersonLimited'] ?? false)), true);",
                    "onAdd": "echo VDM10_UIPersonSave($id, '', $Persons['PersonName'], $Persons['PersonPin'], $Persons['PersonLimited'], $Persons['PersonBegin'], $Persons['PersonEnd'], (int) $Persons['PersonSchedule'], (int) $Persons['PersonPhoto']);",
                    "onEdit": "echo VDM10_UIPersonSave($id, $Persons['PersonNo'], $Persons['PersonName'], $Persons['PersonPin'], $Persons['PersonLimited'], $Persons['PersonBegin'], $Persons['PersonEnd'], (int) $Persons['PersonSchedule'], (int) $Persons['PersonPhoto']);"
                },
                {
                    "type": "Button",
                    "caption": "Reload",
                    "onClick": "VDM10_UIReloadPersons($id);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "SchedulesPanel",
            "caption": "Access schedules",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "A schedule limits fingerprint, card and PIN of the assigned persons to the time windows. Assign it in the person dialog. Until 23:59 means until midnight."
                },
                {
                    "type": "List",
                    "name": "Schedules",
                    "caption": "Schedules on the door station",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "No.",
                            "name": "ScheduleNo",
                            "width": "60px",
                            "add": 0
                        },
                        {
                            "caption": "Name",
                            "name": "name",
                            "width": "180px",
                            "add": ""
                        },
                        {
                            "caption": "Times",
                            "name": "times",
                            "width": "auto",
                            "add": ""
                        },
                        {
                            "caption": "Persons",
                            "name": "persons",
                            "width": "200px",
                            "add": ""
                        },
                        {
                            "name": "ScheduleName",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "ScheduleWindows",
                            "visible": false,
                            "add": [],
                            "edit": {
                                "type": "List"
                            }
                        }
                    ],
                    "values": [],
                    "form": [
                        {
                            "type": "ValidationTextBox",
                            "name": "ScheduleName",
                            "caption": "Name",
                            "width": "320px",
                            "validate": "^.{1,32}$"
                        },
                        {
                            "type": "List",
                            "name": "ScheduleWindows",
                            "caption": "Time windows",
                            "rowCount": 5,
                            "add": true,
                            "delete": true,
                            "columns": [
                                {
                                    "caption": "Days",
                                    "name": "Days",
                                    "width": "180px",
                                    "add": "weekdays",
                                    "edit": {
                                        "type": "Select",
                                        "options": [
                                            {
                                                "caption": "Mon–Fri",
                                                "value": "weekdays"
                                            },
                                            {
                                                "caption": "Sat + Sun",
                                                "value": "weekend"
                                            },
                                            {
                                                "caption": "Daily",
                                                "value": "daily"
                                            },
                                            {
                                                "caption": "Monday",
                                                "value": "mon"
                                            },
                                            {
                                                "caption": "Tuesday",
                                                "value": "tue"
                                            },
                                            {
                                                "caption": "Wednesday",
                                                "value": "wed"
                                            },
                                            {
                                                "caption": "Thursday",
                                                "value": "thu"
                                            },
                                            {
                                                "caption": "Friday",
                                                "value": "fri"
                                            },
                                            {
                                                "caption": "Saturday",
                                                "value": "sat"
                                            },
                                            {
                                                "caption": "Sunday",
                                                "value": "sun"
                                            }
                                        ]
                                    }
                                },
                                {
                                    "caption": "From",
                                    "name": "From",
                                    "width": "120px",
                                    "add": "{\"hour\":8,\"minute\":0,\"second\":0}",
                                    "edit": {
                                        "type": "SelectTime"
                                    }
                                },
                                {
                                    "caption": "Until",
                                    "name": "To",
                                    "width": "120px",
                                    "add": "{\"hour\":17,\"minute\":0,\"second\":0}",
                                    "edit": {
                                        "type": "SelectTime"
                                    }
                                }
                            ]
                        }
                    ],
                    "onAdd": "echo VDM10_UIScheduleSave($id, 0, $Schedules['ScheduleName'], json_encode($Schedules['ScheduleWindows']));",
                    "onEdit": "echo VDM10_UIScheduleSave($id, (int) $Schedules['ScheduleNo'], $Schedules['ScheduleName'], json_encode($Schedules['ScheduleWindows']));",
                    "onDelete": "echo VDM10_UIScheduleDelete($id, (int) $Schedules['ScheduleNo']);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "DevicePanel",
            "caption": "Door station settings",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "DevOpen1",
                            "caption": "Opening time door 1",
                            "digits": 1,
                            "minimum": 0.1,
                            "maximum": 600,
                            "suffix": "s"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "DevOpen2",
                            "caption": "Opening time door 2",
                            "digits": 1,
                            "minimum": 0.1,
                            "maximum": 600,
                            "suffix": "s"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "DevOutput2",
                    "caption": "Output 2",
                    "width": "320px",
                    "options": [
                        {
                            "caption": "Disabled",
                            "value": "disable"
                        },
                        {
                            "caption": "Second door opener",
                            "value": "electricLock"
                        },
                        {
                            "caption": "External door chime",
                            "value": "mechanicalDoorbell"
                        },
                        {
                            "caption": "On motion at night",
                            "value": "motionDeteAndNight"
                        },
                        {
                            "caption": "In night mode",
                            "value": "night"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "For a second door opener set output 2 to “Second door opener” and the number of door openers to 2."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "DevInput1",
                            "caption": "Input 1",
                            "width": "260px",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "DevInput2",
                            "caption": "Input 2",
                            "width": "260px",
                            "options": []
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "DevInput3",
                            "caption": "Input 3",
                            "width": "260px",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "DevInput4",
                            "caption": "Input 4",
                            "width": "260px",
                            "options": []
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "DevFpLevel",
                    "caption": "Fingerprint security level",
                    "width": "320px",
                    "options": [
                        {
                            "caption": "1 (tolerant)",
                            "value": 1
                        },
                        {
                            "caption": "2",
                            "value": 2
                        },
                        {
                            "caption": "3",
                            "value": 3
                        },
                        {
                            "caption": "4",
                            "value": 4
                        },
                        {
                            "caption": "5 (strict)",
                            "value": 5
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "DevSmTamper",
                    "caption": "Tamper alarm of the security module"
                },
                {
                    "type": "Button",
                    "caption": "Save to the door station",
                    "confirm": "Write the changed settings to the door station now?",
                    "onClick": "echo VDM10_UIDeviceSave($id, $DevOpen1, $DevOpen2, $DevOutput2, $DevInput1, $DevInput2, $DevInput3, $DevInput4, (int) $DevFpLevel, $DevSmTamper);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ModulesPanel",
            "caption": "Extension modules and bell buttons",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Modules on the RS-485 bus of the door station (e.g. VDM10-TDM touch display, name plate, button, keypad and info modules, fingerprint and card reader). Display modules can be set up with the edit button."
                },
                {
                    "type": "List",
                    "name": "SubModules",
                    "caption": "Extension modules on the bus of the door station",
                    "rowCount": 4,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "No.",
                            "name": "no",
                            "width": "60px",
                            "add": 0
                        },
                        {
                            "caption": "Module",
                            "name": "name",
                            "width": "auto",
                            "add": ""
                        },
                        {
                            "caption": "Model",
                            "name": "model",
                            "width": "130px",
                            "add": ""
                        },
                        {
                            "caption": "Status",
                            "name": "status",
                            "width": "100px",
                            "add": ""
                        },
                        {
                            "caption": "Firmware",
                            "name": "version",
                            "width": "180px",
                            "add": ""
                        },
                        {
                            "name": "ModId",
                            "visible": false,
                            "add": 0
                        },
                        {
                            "name": "ModBrightness",
                            "visible": false,
                            "add": 0
                        },
                        {
                            "name": "ModTone",
                            "visible": false,
                            "add": false
                        },
                        {
                            "name": "ModTheme",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "ModStart",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "ModCallCenter",
                            "visible": false,
                            "add": false
                        },
                        {
                            "name": "ModCallCenterName",
                            "visible": false,
                            "add": ""
                        },
                        {
                            "name": "ModRingDirectly",
                            "visible": false,
                            "add": false
                        }
                    ],
                    "form": "return json_decode(VDM10_UISubModuleForm($id, (int) ($SubModules['ModId'] ?? 0)), true);",
                    "onEdit": "echo VDM10_UISubModuleSave($id, (int) $SubModules['ModId'], (int) $SubModules['ModBrightness'], (bool) $SubModules['ModTone'], (string) $SubModules['ModTheme'], (string) $SubModules['ModStart'], (bool) $SubModules['ModCallCenter'], (string) $SubModules['ModCallCenterName'], (bool) $SubModules['ModRingDirectly']);"
                },
                {
                    "type": "Label",
                    "caption": "Each bell button calls the indoor station with the given room number. Virtual buttons of a touch display appear here as well."
                },
                {
                    "type": "List",
                    "name": "Keys",
                    "caption": "Bell buttons",
                    "rowCount": 5,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "No.",
                            "name": "no",
                            "width": "60px",
                            "add": 0
                        },
                        {
                            "caption": "Location",
                            "name": "where",
                            "width": "160px",
                            "add": ""
                        },
                        {
                            "caption": "Calls room",
                            "name": "room",
                            "width": "110px",
                            "add": ""
                        },
                        {
                            "caption": "Label",
                            "name": "label",
                            "width": "auto",
                            "add": ""
                        },
                        {
                            "name": "KeyId",
                            "visible": false,
                            "add": 0
                        },
                        {
                            "name": "KeyRoom",
                            "visible": false,
                            "add": 1
                        },
                        {
                            "name": "KeyLabel",
                            "visible": false,
                            "add": ""
                        }
                    ],
                    "form": [
                        {
                            "type": "NumberSpinner",
                            "name": "KeyRoom",
                            "caption": "Calls room number",
                            "minimum": 1,
                            "maximum": 9999
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "KeyLabel",
                            "caption": "Label (shown on touch displays, max. 30 characters)",
                            "width": "320px",
                            "validate": "^.{0,30}$"
                        }
                    ],
                    "onEdit": "echo VDM10_UIKeySave($id, (int) $Keys['KeyId'], (int) $Keys['KeyRoom'], (string) $Keys['KeyLabel']);"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Open door 1",
                    "onClick": "echo VDM10_UnlockDoor($id, 1) ? 'OK' : 'Error';"
                },
                {
                    "type": "Button",
                    "caption": "Open door 2",
                    "onClick": "echo VDM10_UnlockDoor($id, 2) ? 'OK' : 'Error';"
                },
                {
                    "type": "Button",
                    "caption": "Take snapshot",
                    "onClick": "echo VDM10_TakeSnapshot($id) ? 'OK' : 'Error';"
                },
                {
                    "type": "Button",
                    "caption": "Call status",
                    "onClick": "echo VDM10_UpdateCallStatus($id);"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Reconnect event stream",
                    "onClick": "VDM10_ReconnectStream($id); echo 'OK';"
                },
                {
                    "type": "Button",
                    "caption": "Reboot door station",
                    "confirm": "Reboot the door station now?",
                    "onClick": "echo VDM10_Reboot($id) ? 'OK' : 'Error';"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Connected"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "No host configured"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Authentication failed (check user name / password)"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Door station not reachable"
        }
    ]
}
